{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"paths": {
			"react": ["./node_modules/preact/compat"],
			"react-dom": ["./node_modules/preact/compat"]
		},
		"strict": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["vite/client", "node"]
	},
	"include": ["src", "tests", "vite.config.ts"]
}
